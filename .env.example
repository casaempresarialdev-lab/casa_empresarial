# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local nunca deve ser commitado (já está no .gitignore).
# Peça as chaves reais a quem administra o projeto no Supabase.

# Project Settings → API, no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service role) — bypassa RLS. Usada só em Server Actions/admin.
# NUNCA expor no client nem commitar.
SUPABASE_SERVICE_ROLE_KEY=

# URL base do app (usada em links de convite/onboarding/e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000
